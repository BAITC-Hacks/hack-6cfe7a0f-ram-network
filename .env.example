# Copy values into your host's secret environment. This file is NOT loaded automatically.
# Never commit real credentials. Production requires every non-optional value below.
FIREBIRD_DEV=0
FIREBIRD_PUBLIC_URL=https://firebird.example.com
FIREBIRD_DATABASE=/data/firebird.sqlite3
FIREBIRD_MAIL_FROM=Firebird <hello@example.com>
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional; otherwise derived from FIREBIRD_PUBLIC_URL.
TURNSTILE_HOSTNAME=firebird.example.com
FIREBIRD_TIMEZONE=Asia/Almaty
# Bind publicly ONLY behind the platform's TLS reverse proxy.
FIREBIRD_BIND=0.0.0.0
# Optional exact source IP of ONE controlled reverse proxy, never *.
# Leave empty when unknown (do not trust incoming X-Forwarded-For headers).
FIREBIRD_TRUSTED_PROXY=
PORT=4173
